PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cpsu_etms

# Google Sign-In: the same OAuth Client ID as REACT_APP_GOOGLE_CLIENT_ID in
# frontend/.env. Empty = signing in with Google is turned off.
GOOGLE_CLIENT_ID=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=168

CORS_ORIGIN=http://localhost:3000

# Email for sign-up / password-reset codes. Empty SMTP_HOST = codes are printed
# to this server's log instead (fine for development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: read a poster chosen on the create-event page with AI to fill the form.
# Gemini is used when GEMINI_API_KEY is set (free key at aistudio.google.com;
# free-tier content may be used by Google to improve its products), else Claude
# when ANTHROPIC_API_KEY is set (console.anthropic.com). With neither, the browser
# reads the poster with OCR instead (free, less accurate).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
