# Copy to deploy/.env and fill in. Never commit the filled-in file.
# Make each secret with:  openssl rand -hex 32

# Address of the site, without https:// (e.g. cpsu-etms.duckdns.org).
DOMAIN=

# Database. DB_USER/DB_PASSWORD are what the backend uses; the root password
# is only for backups and maintenance.
DB_USER=etms
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Signs log-ins (and the online check-in links). Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_HOURS=168

# Google Sign-In: the OAuth client ID from Google Cloud Console (empty = email log-in only).
GOOGLE_CLIENT_ID=

# Optional off-site copy of the nightly backup, as an rclone destination (e.g. gdrive:cpsu-etms-backups).
BACKUP_REMOTE=
