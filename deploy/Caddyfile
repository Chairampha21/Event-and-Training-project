# One site: the React app, with /api passed to the Go backend. Caddy gets and
# renews the HTTPS certificate for {$DOMAIN} by itself (ports 80 and 443 must
# be open to the internet).
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:4000
	}

	handle {
		root * /srv
		# Hashed build files never change; index.html must always be fresh.
		header /static/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
